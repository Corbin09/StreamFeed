# PostgreSQL
POSTGRES_USER=streamfeed
POSTGRES_PASSWORD=streamfeed
POSTGRES_DB=streamfeed
POSTGRES_PORT=5433

# Backend
DATABASE_URL=postgresql+psycopg://streamfeed:streamfeed@localhost:5433/streamfeed
DATA_DIR=../data
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# Crawling
DEFAULT_CRAWL_INTERVAL_MINUTES=120
CRAWL_JITTER_MINUTES=15
USD_VND_RATE=26000
STALE_AFTER_DAYS=30

# Login for the whole site (required by docker-compose.prod.yml; optional on localhost)
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

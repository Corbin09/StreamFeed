# Environment
.env

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node
node_modules/
.next/
out/

# Data (crawled content and browser sessions must never be committed)
data/raw/*

data/sessions/*
!data/sessions/.gitkeep
data/exports/*
!data/exports/.gitkeep

# OS / editor
.DS_Store
.idea/
.vscode/

# Mermaid exports from scripts/render-diagrams.sh (generated on demand)
docs/diagrams/mermaid/

# Third-party style reference for the overview drawing (not ours to publish)
docs/diagrams/template.jpeg
